# ==============================================================================
# Sahaj Seva Portal - Environment Variables Reference
# ==============================================================================

# Database Connection (PostgreSQL)
# Used by Prisma Client and Prisma Migrate
DATABASE_URL="postgresql://sahaj_user:sahaj_secure_password_2026@localhost:5432/sahaj_seva_db?schema=public"

# Node Environment ("development" | "production" | "test")
NODE_ENV="development"

# ==============================================================================
# Demo Mode Guards (Phase 1 & Phase 2)
# ==============================================================================
# Controls whether in-memory mock auth & sample demo simulation buttons are active.
# MUST BE SET TO "false" IN PRODUCTION.
DEMO_MODE="true"

# Prevents accidental deletion or synthetic data seeding in production databases.
# seed.demo.ts will immediately terminate if NODE_ENV=production unless ALLOW_DEMO_SEED=true.
ALLOW_DEMO_SEED="true"

# ==============================================================================
# Upcoming Phase Placeholders (Documented Adapter Configurations)
# ==============================================================================

# Phase 2: Session & Authentication
# AUTH_SECRET="generate-a-32-byte-hex-key-for-iron-session-or-auth-js"
# SMS_PROVIDER="console" # Options: "console" (dev/demo), "msg91", "twilio"
# MSG91_AUTH_KEY=""
# MSG91_SENDER_ID="SHJSEV"
# MSG91_OTP_TEMPLATE_ID=""

# Phase 3: Storage & OCR Adapters
# STORAGE_PROVIDER="local" # Options: "local", "s3", "r2"
# S3_BUCKET_NAME=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# OCR_PROVIDER="tesseract" # Options: "tesseract", "google-vision"

# Phase 4: Field-Level Data Encryption (AES-GCM for PII like Aadhaar)
# ENCRYPTION_KEY="32-character-random-hex-string"
