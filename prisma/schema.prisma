generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// Enums
// ==============================================================================

enum Role {
  CITIZEN
  OFFICER
  HEAD
  CDO
}

enum ApplicationStatus {
  DRAFT
  PRECHECK_FAILED
  SUBMITTED
  DOCS_VERIFIED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  VISIT_SCHEDULED
  VISIT_COMPLETED
  REJECTED
}

enum BookingStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum DocStatus {
  PASS
  WARNING
  REJECTED
}

enum GrievanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum NotificationChannel {
  SMS
  WHATSAPP
}

enum ProcessType {
  ONLINE
  SEMI_ONLINE
  OFFLINE
}

// ==============================================================================
// Models
// ==============================================================================

model User {
  id            String        @id @default(cuid())
  phone         String?       @unique
  email         String?       @unique
  name          String
  role          Role          @default(CITIZEN)
  officeId      String?
  office        Office?       @relation(fields: [officeId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // DPDP 2023 Compliance & Soft-delete
  deletedAt     DateTime?
  isAnonymized  Boolean       @default(false)
  anonymizedAt  DateTime?

  // Relations
  applications  Application[]
  handledVisits Visit[]       @relation("OfficerHandledVisits")

  @@index([phone])
  @@index([email])
  @@index([officeId])
  @@index([role])
}

model Office {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  nameHi       String
  address      String
  zone         String
  tehsil       String
  lat          Float
  lng          Float
  officerCount Int           @default(5)
  contactPhone String        @default("0120-2820000")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Source citation for zero fabrication
  source       String        @default("UP Local Government Directory (LGD)")
  verifiedAt   DateTime?

  // Relations
  users        User[]
  applications Application[]
  slots        Slot[]
  bookings     Booking[]
  visits       Visit[]
  grievances   Grievance[]

  @@index([zone])
  @@index([tehsil])
}

model Service {
  id                    String            @id @default(cuid())
  code                  String            @unique
  name                  String
  nameHi                String
  description           String
  descriptionHi         String
  category              String
  fee                   Int               @default(0)
  slaDays               Int               @default(7)
  physicalVisitRequired Boolean           @default(false)
  processType           ProcessType       @default(ONLINE)
  carryDocsJson         Json              @default("[]")
  officeType            String
  commonMistakes        Json              @default("[]")
  commonMistakesHi      Json              @default("[]")
  stepsJson             Json              @default("[]")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Source citation for zero fabrication
  source                String            @default("UP e-District Citizen Charter & Janhit Guarantee Act")
  verifiedAt            DateTime?

  // Relations
  documents             ServiceDocument[]
  applications          Application[]

  @@index([category])
  @@index([processType])
  @@index([officeType])
}

model ServiceDocument {
  id               String   @id @default(cuid())
  serviceId        String
  service          Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  docCode          String
  name             String
  nameHi           String
  isMandatory      Boolean  @default(true)
  alternativesJson Json     @default("[]")
  criteriaJson     Json     @default("{}")
  order            Int      @default(1)

  @@index([serviceId])
  @@index([docCode])
}

model Application {
  id                      String                @id @default(cuid())
  trackingNumber          String                @unique
  serviceId               String
  service                 Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  userId                  String?
  user                    User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  citizenName             String
  citizenPhone            String
  citizenAadhaarLast4     String
  officeId                String
  office                  Office                @relation(fields: [officeId], references: [id], onDelete: Restrict)
  status                  ApplicationStatus     @default(SUBMITTED)
  currentStage            String                @default("Submitted")
  visitReadyScore         Int                   @default(85)
  stuckReason             String?
  stuckReasonHi           String?
  actionRequiredDetails   String?
  assignedOfficerName     String?               @default("Desk 3 - Verifying Officer")
  estimatedCompletionDate DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  // DPDP 2023 Compliance & Soft-delete
  deletedAt               DateTime?
  isAnonymized            Boolean               @default(false)
  anonymizedAt            DateTime?

  // Relations
  documents               ApplicationDocument[]
  events                  ApplicationEvent[]
  booking                 Booking?
  visits                  Visit[]
  grievances              Grievance[]
  notifications           NotificationLog[]

  @@index([officeId])
  @@index([status])
  @@index([createdAt])
  @@index([citizenPhone])
  @@index([serviceId])
  @@index([userId])
}

model ApplicationDocument {
  id               String      @id @default(cuid())
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  docCode          String
  docName          String
  fileUrl          String
  fileType         String
  fileSizeKb       Int
  status           DocStatus   @default(PASS)
  issuesJson       Json        @default("[]")
  simulatedAiScore Int         @default(95)
  uploadedAt       DateTime    @default(now())

  // DPDP Compliance
  deletedAt        DateTime?

  @@index([applicationId])
  @@index([docCode])
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage         String
  title         String
  titleHi       String
  description   String
  descriptionHi String
  actorRole     String
  actorName     String
  deskInfo      String
  timestamp     DateTime    @default(now())

  @@index([applicationId])
  @@index([timestamp])
}

model Slot {
  id          String    @id @default(cuid())
  officeId    String
  office      Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  date        String    // YYYY-MM-DD
  startTime   String    // e.g. "10:00 AM"
  endTime     String    // e.g. "10:15 AM"
  capacity    Int       @default(15)
  bookedCount Int       @default(0)
  isAvailable Boolean   @default(true)

  bookings    Booking[]

  @@unique([officeId, date, startTime])
  @@index([officeId, date])
}

model Booking {
  id            String        @id @default(cuid())
  applicationId String        @unique
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  slotId        String
  slot          Slot          @relation(fields: [slotId], references: [id], onDelete: Restrict)
  tokenNumber   String
  qrCodeData    String
  date          String
  timeSlot      String
  officeId      String
  office        Office        @relation(fields: [officeId], references: [id], onDelete: Cascade)
  status        BookingStatus @default(BOOKED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  visits        Visit[]

  @@index([slotId])
  @@index([officeId, date])
  @@index([status])
}

model Visit {
  id              String      @id @default(cuid())
  bookingId       String?
  booking         Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  officerId       String
  officer         User        @relation("OfficerHandledVisits", fields: [officerId], references: [id], onDelete: Restrict)
  officeId        String
  office          Office      @relation(fields: [officeId], references: [id], onDelete: Cascade)
  durationMinutes Int         @default(2)
  isRepeatVisit   Boolean     @default(false)
  repeatReason    String?
  notes           String?
  completedAt     DateTime    @default(now())

  @@index([applicationId])
  @@index([officeId])
  @@index([officerId])
  @@index([completedAt])
  @@index([isRepeatVisit])
}

model Grievance {
  id              String          @id @default(cuid())
  ticketNumber    String          @unique
  applicationId   String?
  application     Application?    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  citizenName     String
  citizenPhone    String
  officeId        String
  office          Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  issueCategory   String
  description     String
  status          GrievanceStatus @default(OPEN)
  resolutionNotes String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([applicationId])
  @@index([officeId])
  @@index([status])
  @@index([citizenPhone])
}

model NotificationLog {
  id             String              @id @default(cuid())
  recipientPhone String
  recipientName  String
  channel        NotificationChannel @default(SMS)
  title          String
  message        String
  status         String              @default("DELIVERED")
  applicationId  String?
  application    Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  timestamp      DateTime            @default(now())

  // DPDP Compliance
  deletedAt      DateTime?
  isAnonymized   Boolean             @default(false)

  @@index([recipientPhone])
  @@index([applicationId])
  @@index([timestamp])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String
  actorRole   String
  action      String
  entityType  String
  entityId    String
  detailsJson Json     @default("{}")
  timestamp   DateTime @default(now())

  @@index([entityId, entityType])
  @@index([actorId])
  @@index([timestamp])
}
